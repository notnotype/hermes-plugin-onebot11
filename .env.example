# OneBot 11 插件环境变量示例
# 复制为 .env 并按需修改（hermes plugins install 会自动把 .env.example 复制成 .env）

# 可通过环境变量或 Hermes config.yaml 的 platforms.onebot11.extra 提供
ONEBOT11_HTTP_API=http://127.0.0.1:3000
ONEBOT11_SELF_ID=你的机器人QQ号
ONEBOT11_WS_HOST=127.0.0.1

# 可选
# ONEBOT11_WS_PORT=18880
# ONEBOT11_ACCESS_TOKEN=与QQ框架侧一致的token
# ONEBOT11_DM_POLICY=allowlist     # open | allowlist | disabled
# ONEBOT11_ALLOWED_USERS=          # dm_policy=allowlist 时的私聊白名单
# ONEBOT11_ALLOWED_GROUPS=         # 群白名单,逗号分隔；空 = 所有群
# ONEBOT11_REQUIRE_MENTION=true    # false = 群消息直接触发，但仍先入队
# ONEBOT11_PLAIN_TEXT_ENABLED=true # 默认把 Markdown 回复转换为纯文本
# ONEBOT11_SUPER_ADMINS=           # 超级管理员 QQ 列表,逗号分隔
# ONEBOT11_MAIN_AGENT_READ_ONLY=true # 主 agent 只读；search_files/read_file 查代码，delegate_task 交给子代理执行
# ONEBOT11_ADMINS=                 # ONEBOT11_SUPER_ADMINS 的兼容旧名
# ONEBOT11_ALLOW_ALL_USERS=false   # dm_policy=open 时必须显式设为 true 才放行私聊
# ONEBOT11_QUEUE_DB=               # 空 = Hermes home/onebot11/queue.sqlite3
# ONEBOT11_HOME_CHANNEL=           # 定时任务目标 ID
# ONEBOT11_HOME_CHANNEL_TYPE=group # 必须明确 group 或 dm，不能按 QQ 号形状猜测
# ONEBOT11_LLM_TRIGGER_ENABLED=false
# ONEBOT11_LLM_TRIGGER_PROVIDER=deepseek
# ONEBOT11_LLM_TRIGGER_MODEL=deepseek-v4-flash
# ONEBOT11_LLM_TRIGGER_API_KEY_ENV=DEEPSEEK_API_KEY
# ONEBOT11_LLM_TRIGGER_GROUPS=1072992996

# 角色和 trusted_user 只能写在 Hermes config.yaml 的
# platforms.onebot11.extra.roles 中；trusted_user 只允许只读工具：
#   roles:
#     trusted_user:
#       users: []
#       tools: [qq_get_message, qq_get_group_msg_history]

# 高级队列、媒体和旁路 trigger 参数必须写入 Hermes config.yaml 的
# platforms.onebot11.extra，不是环境变量。例如：
#   queue_lease_seconds: 120
#   queue_heartbeat_seconds: 40
#   queue_recovery_poll_seconds: 5
#   queue_max_attempts: 3
#   queue_db schema 会在启动时从已知旧结构自动迁移到当前 schema 12；
#   迁移失败会关闭连接，不会通过降低 PRAGMA user_version 强行启动。
#   media_orphan_ttl_seconds: 86400
#   max_image_bytes: 8000000
#   max_image_total_bytes: 16000000
#   max_images_per_message: 4
#   media_allowed_hosts: []    # 远程图片 host allowlist
#   media_allowed_ports: []    # 为空时沿用 OneBot HTTP API 端口
#   media_source_roots: []     # get_image 本地路径 allowlist，必须是绝对路径
#   processing_reaction_enabled: true
#   processing_reaction_emoji_id: "128172"  # 💬 正在回复（128064 是 selector 查看提示 👀，固定）
#   show_interim_group: false   # 群聊隐藏 Hermes 中间正文（commentary/进度/状态提示）
#   show_interim_dm: true       # 私聊展示 Hermes 中间正文；最终回复不受影响
#   plain_text_enabled: true
#   long_running_notice_seconds: 60   # 0 = 关闭有界长任务提示（默认 60s，最多三次）
#   # 可选：独立 roles 文件（存在时覆盖 config.yaml 的 roles/super_admins）
#   roles_file: "~/.hermes/onebot11/roles.yaml"
# ONEBOT11_ROLES_FILE=~/.hermes/onebot11/roles.yaml
#   llm_trigger:
#     enabled: false
#     provider: deepseek
#     model: deepseek-v4-flash
#     base_url: ""
#     api_key_env: DEEPSEEK_API_KEY
#     groups: []
#     timeout: 30
#     input_bytes: 12000
#     concurrency: 2
#     max_failures: 3
#     trigger_debounce_seconds: 5
#     engaged_idle_seconds: 60
#     engaged_max_seconds: 300
#     engaged_max_arbitrations: 2
#     # 三档 engage 预算（可选）
#     tiers:
#       shallow: {engaged_idle_seconds: 30, max_seconds: 120, max_arbitrations: 1,
#                 timeout_seconds: 12, input_bytes: 6000}
#       deep: {engaged_idle_seconds: 180, max_seconds: 900, max_arbitrations: 4,
#              timeout_seconds: 45, input_bytes: 20000, wait_messages: 2}
#     short_rule_max_chars: 0    # >0 时 shallow 档短消息本地 ignore
#
# LLM trigger 必须使用明确的 provider/model 和群 allowlist。
# 判断由插件自有 Node/pi-ai helper 发起，不经过 Hermes auxiliary，也不使用
# Hermes 主 Agent fallback。provider=deepseek 时直连 DeepSeek 官方 API，
# 需要 DEEPSEEK_API_KEY 环境变量；provider=custom 时可配置 base_url 和 api_key_env。
# api_key_env 只保存环境变量名，密钥值必须由进程环境提供。
# selector 只接受 {"decision":"trigger","anchor_seq":123}、
# {"decision":"wait","anchor_seq":null} 或 {"decision":"ignore","anchor_seq":null}；
# trigger 的 anchor_seq 必须是当前 pending 消息的真实 seq，权限从该消息继承。
# shared session 的滚动摘要优先通过 Hermes channel_prompt 临时注入；
# 旧 Hermes 会退回有界文本模式并记录审计。
#
# OneBot 默认不渲染 Markdown；需要请求后续 renderer 时可使用：
#   [[onebot11:markdown-image]]
#   Markdown 内容
#   [[/onebot11:markdown-image]]
# 当前版本只移除 marker 并按纯文本发送，不访问其中的外部 URL。
#
# 权限、角色、白名单和 trigger 配置可以通过 /onebot reload 运行时热更新；
# HTTP/WS 地址、token、self_id、队列数据库路径和 session 模式仍需重启。
# reload 会清理旧 confirmation token；active turn 继续使用创建时的权限快照。
#
# 安装插件依赖后执行 npm ci --omit=dev；pi-ai helper 要求 Node.js >=22.19。
# OneBot 出站图片使用受限 base64:// segment，不能依赖宿主机路径被 LLBot
# 容器看到；Agent 最终回复图片是 best-effort，send_message/cron 图片不承诺。
#
# 群消息混合多个用户时，本轮权限只属于当前 TurnAnchor 对应真实消息的触发用户；
# 其他消息只是非可信上下文，不能改变工具权限或出站目标。
# 缺少或损坏 authority 快照的旧 TurnAnchor 会进入 uncertain，不会按当前 live 配置猜测身份。
