# OneBot 11 平台环境变量示例
# 复制为 .env 并按需修改;也可写入 ~/.hermes/.env(网关统一加载)

# ── 必填 ──────────────────────────────────────────────
ONEBOT11_HTTP_API=http://127.0.0.1:3000
ONEBOT11_SELF_ID=你的机器人QQ号

# ── 连接 ──────────────────────────────────────────────
# ONEBOT11_WS_PORT=18880
# ONEBOT11_ACCESS_TOKEN=与QQ框架侧一致的token

# ── 群聊 ──────────────────────────────────────────────
# ONEBOT11_ALLOWED_GROUPS=群号1,群号2     # 群白名单;空 = 所有群可用
# ONEBOT11_GROUP_SESSIONS_PER_USER=false  # true = 群里每用户独立会话;false = 一群一会话(默认)
# ONEBOT11_KEYWORD_TRIGGERS=机器人,查询   # 触发关键词(正则,逗号分隔;@ 恒为触发源)
# ONEBOT11_LLM_TRIGGER=false              # true = 未命中 @/关键词时经宿主 LLM 判定是否触发
# ONEBOT11_QUEUE_MAX_ENTRIES=100          # 每群消息队列条数上限
# ONEBOT11_QUEUE_MAX_CHARS_PER_ENTRY=2000 # 单条消息入队截断长度
# ONEBOT11_QUEUE_KEEP_RAW=5               # 触发时保留最近原文条数
# ONEBOT11_QUEUE_CONTEXT_CHARS=1500       # 群聊上下文拼接总长上限

# ── 私聊 ──────────────────────────────────────────────
# ONEBOT11_DM_POLICY=open                 # open | allowlist | disabled
# ONEBOT11_ALLOWED_USERS=QQ,QQ            # 私聊白名单,逗号分隔

# ── 权限与角色 ────────────────────────────────────────
# ONEBOT11_ADMINS=你的QQ号                # 超级管理员(逗号分隔)
# ONEBOT11_ADMIN_TOOLS=                   # admin-only 工具名(逗号分隔;空 = 所有工具普通用户可用)

# ── 定时任务投递 ──────────────────────────────────────
# ONEBOT11_HOME_CHANNEL=群号或QQ号        # 定时任务默认投递目标
